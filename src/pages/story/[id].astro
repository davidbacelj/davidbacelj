---
// One project from the road as a blog post, with David's chosen photo.
import StagePost from "../../components/StagePost.astro";
import { STOPS } from "../../data/sections";
import { COVERS } from "../../data/covers";

export function getStaticPaths() {
  return STOPS.flatMap((stop) => stop.sections).map((s, i) => ({ params: { id: s.id }, props: { i } }));
}
const { i } = Astro.props as { i: number };
---

<StagePost i={i} covers={COVERS} />
