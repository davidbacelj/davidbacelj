---
// One post from the road, with David's chosen photo.
import StagePost from "../../components/StagePost.astro";
import { POSTS } from "../../data/road";
import { COVERS } from "../../data/covers";

export function getStaticPaths() {
  return POSTS.map((p) => ({ params: { id: p.s.id } }));
}
const { id } = Astro.params;
---

<StagePost id={id} covers={COVERS} />
