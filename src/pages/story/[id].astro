---
// One section as a full article: the big photo, the story with its small
// headings, who it was with, every photo large, and the newer and older sections.
import "@fontsource-variable/geist/wght.css";
import "@fontsource-variable/geist-mono/wght.css";
import { Picture } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Logo from "../../components/Logo.astro";
import { SECTIONS, storyHref } from "../../data/sections";
import { STORIES } from "../../data/stories";
import { PHOTOS } from "../../data/profile";

export function getStaticPaths() {
  return SECTIONS.map((s, i) => ({ params: { id: s.id }, props: { i } }));
}

const { i } = Astro.props as { i: number };
const s = SECTIONS[i];
const newer = SECTIONS[i - 1];
const older = SECTIONS[i + 1];
const meta = [s.when ?? s.sign, s.role].filter(Boolean).join(", ");
const story = STORIES[s.id] ?? [];
const photos = [s.photo, ...(s.thumbs ?? [])].filter((p): p is NonNullable<typeof p> => Boolean(p));
---

<Base title={`${s.title} · David Bacelj`} description={s.lede} themeColor="#ddc39d">
  <div class="article-page">
    <nav class="bar" aria-label="Story">
      <a href="/" class="back" data-back>← Back to the road</a>
      <a href="/" class="me">
        <Picture src={PHOTOS.portrait} formats={["avif", "webp"]} widths={[80]} sizes="32px" alt="" />
        David Bacelj
      </a>
    </nav>

    <article class="article">
      {
        s.photo ? (
          <figure class="hero">
            <Picture src={s.photo.src} formats={["avif", "webp"]} widths={[800, 1300, 1800]} sizes="(max-width: 1100px) 94vw, 1040px" alt={s.photo.alt} loading="eager" fetchpriority="high" />
          </figure>
        ) : (
          s.logos && (
            <div class="hero hero-cover">
              {s.logos.map((l) => (
                <Logo src={l.src} alt={l.alt} height={52} />
              ))}
            </div>
          )
        )
      }

      <div class="column">
        <p class="sign">{s.sign}</p>
        {
          s.logos && s.photo && (
            <div class="logos">
              {s.logos.map((l) => (
                <span class:list={["chip", { dark: l.dark }]}>
                  <Logo src={l.src} alt={l.alt} height={Math.round((l.size ?? 24) * 1.15)} />
                </span>
              ))}
            </div>
          )
        }
        <h1>{s.title}</h1>
        <p class="meta">{meta}</p>
        <p class="lede">{s.lede}</p>
        {story.map((part) =>
          part.h ? (
            <section class="part">
              <h2>{part.h}</h2>
              <p class="body">{part.p}</p>
            </section>
          ) : (
            <p class="body">{part.p}</p>
          ),
        )}
        {
          s.quote && (
            <blockquote>
              <p>{s.quote.text}</p>
              <footer>From the {s.quote.source}</footer>
            </blockquote>
          )
        }
        {
          s.with && (
            <dl class="facts">
              <div>
                <dt>Together with</dt>
                <dd>{s.with}</dd>
              </div>
            </dl>
          )
        }
        {
          s.links && (
            <p class="links">
              Read more:
              {s.links.map((l) => (
                <a href={l.href} rel="noopener" target="_blank">
                  {l.label} ↗
                </a>
              ))}
            </p>
          )
        }
      </div>

      {
        photos.length > 1 && (
          <section class="gallery" aria-label="Photos">
            {photos.slice(1).map((p) => (
              <figure>
                <Picture src={p.src} formats={["avif", "webp"]} widths={[600, 1000]} sizes="(max-width: 800px) 94vw, 510px" alt={p.alt} />
                <figcaption>{p.alt}</figcaption>
              </figure>
            ))}
          </section>
        )
      }
    </article>

    <nav class="next" aria-label="More stories">
      {
        newer ? (
          <a href={storyHref(newer.id)} class="next-card">
            <span class="next-dir">← Newer</span>
            <b>{newer.title}</b>
            <span>{newer.sign}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        older && (
          <a href={storyHref(older.id)} class="next-card older">
            <span class="next-dir">Older →</span>
            <b>{older.title}</b>
            <span>{older.sign}</span>
          </a>
        )
      }
    </nav>
  </div>
</Base>

<script>
  // "Back to the road" goes back in history when you came from the road, so
  // the road is where you left it. Otherwise it is a plain link home.
  const back = document.querySelector<HTMLAnchorElement>("[data-back]");
  if (back && document.referrer) {
    try {
      if (new URL(document.referrer).origin === location.origin) {
        back.addEventListener("click", (e) => {
          e.preventDefault();
          history.back();
        });
      }
    } catch {
      /* a malformed referrer keeps the plain link */
    }
  }
</script>

<style>
  .article-page {
    --paper: #f2ebdd;
    --ink: #1d1d1f;
    --dim: #6f685d;
    --accent: #e5601b;
    min-height: 100vh;
    padding: 0 16px 120px;
    background: var(--paper);
    color: var(--ink);
    font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.6;
  }
  .bar {
    max-width: 1040px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 0;
  }
  .bar a {
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
  }
  .back {
    padding: 9px 16px;
    border-radius: 999px;
    background: #fff;
  }
  .me {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .me :global(img) {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 15%;
  }

  .article {
    max-width: 1040px;
    margin: 0 auto;
    padding-bottom: 40px;
    background: #fff;
    border-radius: 30px;
    overflow: hidden;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05), 0 30px 60px -40px rgb(40 30 10 / 0.4);
  }
  .hero {
    view-transition-name: story-hero;
  }
  .hero :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .hero-cover {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
    flex-wrap: wrap;
    aspect-ratio: 16 / 7;
    background: #f6f3ec;
  }
  .column {
    max-width: 700px;
    margin: 0 auto;
    padding: 40px 24px 10px;
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  .sign {
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
    font-weight: 650;
    font-size: 14px;
  }
  .logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }
  /* A white-only logo sits on a small dark chip. */
  .chip.dark {
    padding: 8px 12px;
    border-radius: 8px;
    background: #22201c;
  }
  h1 {
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 720;
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .meta {
    font-family: "Geist Mono Variable", ui-monospace, monospace;
    font-size: 14px;
    color: var(--accent);
    margin-top: -4px;
  }
  .lede {
    font-size: clamp(21px, 2.4vw, 26px);
    font-weight: 520;
    line-height: 1.35;
    letter-spacing: -0.015em;
  }
  .body {
    font-size: 18px;
    line-height: 1.7;
    color: #3d3a40;
  }
  blockquote {
    margin: 8px 0;
    padding: 4px 0 4px 20px;
    border-left: 3px solid #ff6f21;
    font-size: 19px;
    line-height: 1.5;
  }
  blockquote footer {
    margin-top: 6px;
    font-size: 14px;
    color: var(--dim);
  }
  /* A part of the story under its small heading */
  .part {
    width: 100%;
    margin-top: 6px;
  }
  .part h2 {
    font-size: 21px;
    font-weight: 650;
    letter-spacing: -0.015em;
    line-height: 1.25;
    margin-bottom: 6px;
  }
  .facts dt {
    font-size: 13px;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8a857c;
    margin-bottom: 10px;
  }
  .facts {
    width: 100%;
    display: grid;
    gap: 14px;
    margin-top: 6px;
  }
  .facts div {
    padding: 16px 18px;
    border-radius: 16px;
    background: #f6f3ec;
  }
  .facts dt {
    margin-bottom: 4px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-size: 15px;
    color: var(--dim);
  }
  .links a {
    color: var(--ink);
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    padding: 30px 24px 0;
  }
  .gallery figure {
    display: grid;
    gap: 8px;
  }
  .gallery :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 16px;
  }
  .gallery figcaption {
    font-size: 14px;
    color: var(--dim);
  }
  .next {
    max-width: 1040px;
    margin: 24px auto 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .next-card {
    display: grid;
    gap: 2px;
    padding: 20px 24px;
    border-radius: 22px;
    background: #fff;
    text-decoration: none;
  }
  .next-card.older {
    text-align: right;
  }
  .next-dir {
    font-size: 13px;
    color: var(--dim);
  }
  .next-card b {
    font-size: 19px;
    letter-spacing: -0.02em;
  }
  .next-card span:last-child {
    font-size: 13px;
    color: var(--dim);
  }
  @media (max-width: 800px) {
    .article {
      border-radius: 22px;
    }
    .gallery,
    .next {
      grid-template-columns: minmax(0, 1fr);
    }
    .next-card.older {
      text-align: left;
    }
  }
</style>
