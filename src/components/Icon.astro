---
// One icon from Simple Icons (CC0), drawn inline. `brand` paints it in the
// brand's own colour; otherwise it takes the text colour.
import type { SimpleIcon } from "simple-icons";

interface Props {
  icon: SimpleIcon;
  size?: number;
  brand?: boolean;
  class?: string;
  /** Give it a name when it stands alone; leave it out beside its label. */
  label?: string;
}

const { icon, size = 24, brand = false, class: className, label } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill={brand ? `#${icon.hex}` : "currentColor"}
  class:list={["icon", className]}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}><path d={icon.path} /></svg
>
