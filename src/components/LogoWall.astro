---
// Who a post was with, as big logos in a post (David, 2026-10-22): one white
// tile per logo, the same size in every post, with "Together with ..." under
// them like a photo caption. Each logo gets about the same area whatever its
// shape, so a square mark and a long wordmark look equally big. As a post's
// cover (`hero`, Section.logoCover) the tiles are taller and the logos bigger,
// and on that post's road card (`card`) they fill the card's 3:2 photo frame.
import type { ImageMetadata } from "astro";
import Logo from "./Logo.astro";

interface Props {
  logos: { src: ImageMetadata; alt: string; dark?: boolean; scale?: number }[];
  with?: string;
  hero?: boolean;
  card?: boolean;
}
const { logos, with: together, hero = false, card = false } = Astro.props;

const AREA = hero || card ? 14000 : 9000;
const heightOf = (src: ImageMetadata, scale = 1) => Math.min(114, Math.max(24, Math.round(scale * Math.sqrt(AREA / (src.width / src.height)))));
const n = logos.length;
---

<figure class:list={["wall", { hero, card }]}>
  <ul class:list={["tiles", { one: n === 1, two: n === 2 || n === 4, five: n === 5, rows1: n <= 3 }]}>
    {
      logos.map((l) => (
        <li class:list={{ dark: l.dark }}>
          <Logo src={l.src} alt={l.alt} height={heightOf(l.src, l.scale)} />
        </li>
      ))
    }
  </ul>
  {together && <figcaption>Together with {together}.</figcaption>}
</figure>

<style>
  .wall {
    margin: 48px -80px 0;
  }
  .wall.hero {
    max-width: 1120px;
    margin: clamp(48px, 6vw, 80px) auto 0;
  }
  .hero .tiles {
    --row: clamp(150px, 17vw, 210px);
    --pad: 28px;
  }
  .tiles {
    --row: clamp(120px, 14vw, 156px);
    --pad: 20px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: var(--row);
    gap: 12px;
  }
  .tiles.one {
    grid-template-columns: minmax(0, 1fr);
  }
  .tiles.two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  /* Five logos: three on top, two under them, so both rows are full */
  .tiles.five {
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }
  .tiles.five li {
    grid-column: span 2;
  }
  .tiles.five li:nth-child(n + 4) {
    grid-column: span 3;
  }
  .tiles li {
    display: grid;
    place-items: center;
    min-width: 0;
    padding: var(--pad) 28px;
    border-radius: 14px;
    background: #fff;
  }
  .tiles li.dark {
    background: #141414;
  }
  .tiles :global(.logo) {
    max-width: 100%;
    max-height: calc(var(--row) - 2 * var(--pad));
    object-position: center;
  }
  /* On a road card: the tiles fill the 3:2 frame, sized from its height */
  .wall.card {
    height: 100%;
    margin: 0;
    padding: clamp(10px, 2vw, 16px);
    background: #f1eee7;
    container-type: size;
  }
  .card .tiles {
    --rows: 2;
    --row: calc((100cqh - (var(--rows) - 1) * 10px) / var(--rows));
    --pad: clamp(10px, 5cqh, 24px);
    height: 100%;
    gap: 10px;
  }
  .card .tiles.rows1 {
    --rows: 1;
  }
  .card .tiles li {
    padding: var(--pad) clamp(10px, 4cqw, 28px);
  }
  figcaption {
    margin-top: 12px;
    font-size: 14px;
    line-height: 1.45;
    color: #6b675f;
  }

  @media (max-width: 1000px) {
    .wall {
      margin-left: 0;
      margin-right: 0;
    }
  }
  /* Phones: two tiles a row, an odd last one across the whole row */
  @media (max-width: 700px) {
    .wall:not(.card) .tiles {
      --row: 104px;
      --pad: 16px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
    .wall.hero .tiles {
      --row: 116px;
      --pad: 18px;
    }
    .wall:not(.card) .tiles.one {
      grid-template-columns: minmax(0, 1fr);
    }
    .wall:not(.card) .tiles.five li {
      grid-column: auto;
    }
    .wall:not(.card) .tiles li:last-child:nth-child(odd) {
      grid-column: span 2;
    }
    /* A logo alone on its row gets no more width than one in a half tile */
    .wall:not(.card) .tiles li:last-child:nth-child(odd) :global(.logo) {
      max-width: calc(50% - 24px);
    }
    .wall:not(.card) .tiles.one li:last-child {
      grid-column: auto;
    }
    .wall:not(.card) .tiles li {
      padding: var(--pad) 20px;
    }
  }
</style>
