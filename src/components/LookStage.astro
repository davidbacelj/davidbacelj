---
// The home page (David's pick, 2026-10-20): the stage photo filling the first
// screen, then a big welcome film at the start of the road (coming soon until
// he records it), then the road itself: a thin line straight down with his
// posts in his own order (src/data/road.ts), each a card led by a big photo of
// him where he picked one, and his personal photos between them.
import "@fontsource-variable/geist/wght.css";
import { Picture, Image } from "astro:assets";
import Px from "./Px.astro";
import productHuntBadge from "../assets/logos/producthunt-top-post.svg";
import skapaPrize from "../assets/logos/skapa-prize.webp";
import LogoWall from "./LogoWall.astro";
import Icon from "./Icon.astro";
import { STACK, SOCIALS } from "../data/icons";
import { PHOTOS, PERSON } from "../data/profile";
import { MUSIC, storyHref } from "../data/sections";
import { ROAD } from "../data/road";
import { PAUSE_CAPTIONS } from "../data/captions";
import { SECTION_STATS } from "../data/highlights";
import { COVERS } from "../data/covers";
import { documentOf } from "../data/documents";
import { STORIES } from "../data/stories";
import { SWEDEN } from "../data/sweden";
import { WELCOME_SCRIPT } from "../data/welcome";

// An ordinary reading time, at about 220 words a minute.
const minutes = (id: string) => Math.max(1, Math.round((STORIES[id] ?? []).reduce((n, p) => n + p.p.split(/\s+/).length, 0) / 220));

const TENSORFLOW = STACK.find((i) => i.slug === "tensorflow")!;
const LINUX_ICON = STACK.find((i) => i.slug === "linux")!;
const handle = (href: string) => href.replace(/^https:\/\/(www\.)?/, "").replace(/\/$/, "");
const ICONS = ["LinkedIn", "X", "GitHub"].map((n) => SOCIALS.find((s) => s.label === n)!).filter(Boolean);
---

<div class="st" data-stage-root>
  <header class="hero">
    <Picture src={PHOTOS.stage} formats={["avif"]} fallbackFormat="webp" widths={[1000, 1800, 2600, 3200]} sizes="100vw" alt="David Bacelj in a black suit at the podium, hosting Hacking Ground under the stage lights" loading="eager" fetchpriority="high" />
    <div class="hero-text">
      <h1>David Bacelj</h1>
      <p class="hero-line">{PERSON.tagline}</p>
      <ul class="icons">
        {
          ICONS.map((s) => (
            <li>
              <a href={s.href} rel="me noopener" target="_blank" aria-label={s.label} title={s.label}>
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                  <path fill="currentColor" d={s.path} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <p class="hero-credit">Hosting Hacking Ground, Jönköping, 2025</p>
  </header>

  <section class="road" id="road" data-road aria-label="The road">
    <svg class="line" data-line aria-hidden="true"><path data-trace class="trace" /><path data-ink class="ink" /></svg>

    <section class="welcome" aria-labelledby="welcome-title">
      <div class="frame">
        <Px src={PHOTOS.sofa} alt="David Bacelj smiling on a sofa in the office" widths={[800, 1300, 1900]} sizes="(max-width: 900px) 92vw, 1040px" cover class="frame-bg" />
        <div class="frame-inner">
          <span class="play" aria-hidden="true"></span>
          <h2 id="welcome-title">Welcome</h2>
          <p>A short film from me, about who I am and what I build.</p>
          <p class="soon">Coming soon</p>
        </div>
      </div>
      <div class="script">
        {
          WELCOME_SCRIPT.map((p) => {
            const [before, after] = p.split("get in touch");
            return (
              <p>
                {before}
                {after !== undefined && (
                  <>
                    <a href="#contact">get in touch</a>
                    {after}
                  </>
                )}
              </p>
            );
          })
        }
      </div>
      <p class="pill start" data-node>Start</p>
    </section>

    <div class="items">
      {
        ROAD.map((item) => {
          if (item.kind === "break" && item.name === "music")
            return (
              <div class="post">
                <span class="dot" data-node aria-hidden="true" />
                <section class="brk music" aria-labelledby="music-title">
                  <span class="disc" aria-hidden="true">
                    <span />
                  </span>
                  <div>
                    <h2 id="music-title">{MUSIC.artist}, on repeat</h2>
                    <ol class="tracks">
                      {MUSIC.songs.map((t, k) => (
                        <li>
                          <span class="tn">{String(k + 1).padStart(2, "0")}</span>
                          <span class="tt">{t.title}</span>
                          <span class="ty">{t.year}</span>
                        </li>
                      ))}
                    </ol>
                  </div>
                </section>
              </div>
            );
          if (item.kind === "break" && item.name === "tensorflow")
            return (
              <div class="post">
                <span class="dot" data-node aria-hidden="true" />
                <section class="brk tf" aria-labelledby="tf-title">
                  <span class="tf-logo">
                    <Icon icon={TENSORFLOW} size={56} brand label="TensorFlow" />
                  </span>
                  <h2 id="tf-title">I build AI models in TensorFlow</h2>
                  <p>At Wheelscanning I built the vision models from the ground up in TensorFlow: one reads the text on tyres, another finds damage on rims.</p>
                </section>
              </div>
            );
          if (item.kind === "break" && item.name === "home")
            return (
              <div class="post">
                <span class="dot" data-node aria-hidden="true" />
                <section class="brk home" aria-labelledby="home-title">
                  <div class="map-pane">
                  <svg class="map" viewBox={`0 0 ${SWEDEN.width} ${SWEDEN.height}`} role="img" aria-label="A map of Sweden with Jönköping marked at the southern tip of Lake Vättern">
                    <path class="land" d={SWEDEN.land} />
                    <path class="lakes" d={SWEDEN.lakes} />
                    <circle class="ping" cx={SWEDEN.home.x} cy={SWEDEN.home.y} r="8" />
                    <circle class="here" cx={SWEDEN.home.x} cy={SWEDEN.home.y} r="8" />
                    <text class="here-name" x={SWEDEN.home.x + 6} y={SWEDEN.home.y + 42}>
                      Jönköping
                    </text>
                  </svg>
                  </div>
                  <div class="home-text">
                    <p class="coords">57.78° N, 14.16° E</p>
                    <h2 id="home-title">I live in Jönköping</h2>
                    <p>This corner of Sweden, at the southern tip of Lake Vättern. I grew up here, and it is where we build Incredible.</p>
                  </div>
                </section>
              </div>
            );
          if (item.kind === "break" && item.name === "producthunt")
            return (
              <div class="post">
                <span class="dot" data-node aria-hidden="true" />
                <section class="brk award" aria-labelledby="ph-title">
                  <img class="ph-badge" src={productHuntBadge.src} width={productHuntBadge.width} height={productHuntBadge.height} alt="Product Hunt: #1 Product of the Day" loading="lazy" decoding="async" />
                  <h2 id="ph-title">Number one on Product Hunt</h2>
                  <p>Our agent platform was the #1 product of the day on Product Hunt in 2025.</p>
                </section>
              </div>
            );
          if (item.kind === "break" && item.name === "skapa")
            return (
              <div class="post">
                <span class="dot" data-node aria-hidden="true" />
                <section class="brk award" aria-labelledby="skapa-title">
                  <Image src={skapaPrize} alt="SKAPA, the innovation prize in memory of the inventor Alfred Nobel" widths={[460, 770]} sizes="(max-width: 900px) 80vw, 460px" class="skapa-mark" loading="lazy" />
                  <h2 id="skapa-title">Winner of the SKAPA prize</h2>
                  <p>Sweden's largest innovation prize, founded in memory of Alfred Nobel. We won it for Jönköping County in 2024 and took second in all of Sweden.</p>
                </section>
              </div>
            );
          if (item.kind === "break" && item.name === "linux")
            return (
              <div class="post">
                <span class="dot" data-node aria-hidden="true" />
                <section class="brk lx" aria-labelledby="linux-title">
                  <span class="lx-logo">
                    <Icon icon={LINUX_ICON} size={104} brand label="Linux" />
                  </span>
                  <div>
                    <h2 id="linux-title">At home in the terminal</h2>
                    <p>Linux and Bash are where I'm fastest, on my own machine and on servers in the cloud.</p>
                  </div>
                </section>
              </div>
            );
          if (item.kind === "break")
            return (
              <div class="post">
                <span class="dot" data-node aria-hidden="true" />
                <section class="brk profiles" aria-labelledby="profiles-title">
                  <h2 id="profiles-title">Follow along</h2>
                  <ul>
                    {ICONS.map((x) => (
                      <li>
                        <a href={x.href} rel="me noopener" target="_blank" class:list={["prof", x.label.toLowerCase()]}>
                          <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true">
                            <path fill="currentColor" d={x.path} />
                          </svg>
                          <span class="pl">{x.label}</span>
                          <span class="ph">{handle(x.href)}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </section>
              </div>
            );
          if (item.kind === "pause")
            return (
              <div class="post">
                <span class="dot" data-node aria-hidden="true" />
                <figure class="pause">
                  <Px src={item.photo.src} alt={item.photo.alt} widths={[500, 900]} sizes="(max-width: 900px) 90vw, 520px" />
                  <figcaption>{PAUSE_CAPTIONS[item.sign] ?? item.text}</figcaption>
                </figure>
              </div>
            );
          const { s, year } = item;
          const doc = documentOf(s, COVERS[s.id]);
          const stat = SECTION_STATS[s.id];
          return (
            <div class="post">
              <span class="dot" data-node aria-hidden="true" />
              <a class="doc" href={storyHref(s.id)} data-doc={s.id} id={s.id}>
                <span class="sheet">
                  {s.collage ? (
                    <span class:list={["d-photo d-collage", { five: (s.thumbs ?? []).length === 4, six: (s.thumbs ?? []).length >= 5 }]}>
                      {[s.photo, ...(s.thumbs ?? [])].filter((p) => p !== undefined).slice(0, 6).map((p) => (
                        <Px src={p.src} alt={p.alt} widths={[400, 700]} sizes="(max-width: 900px) 62vw, 550px" cover />
                      ))}
                    </span>
                  ) : s.logoCover && s.logos ? (
                    <span class="d-photo">
                      <LogoWall logos={s.logos} card />
                    </span>
                  ) : (
                    doc.cover && (
                      <span class="d-photo">
                        <Px src={doc.cover.photo.src} alt={doc.cover.photo.alt} widths={[700, 1100, 1600]} sizes="(max-width: 900px) 92vw, 820px" cover />
                      </span>
                    )
                  )}
                  <span class="d-body">
                    <span class="d-meta">
                      <span>{[year, s.role].filter(Boolean).join(", ")}</span>
                      <span>{minutes(s.id)} min read{s.video ? ", with film" : ""}</span>
                    </span>
                    <span class="d-title">{doc.title}</span>
                    <span class="d-text">{s.lede}</span>
                    <span class="d-foot">
                      {stat && (
                        <span class="d-stat">
                          <b class="marker scroll">{stat.value}</b> {stat.label}
                        </span>
                      )}
                      <span class="d-open">Read the post →</span>
                    </span>
                  </span>
                </span>
              </a>
            </div>
          );
        })
      }
    </div>
  </section>

  <footer class="end">
    <div class="end-grid">
      <div class="touch" id="contact">
        <Px src={PHOTOS.studio} alt="David Bacelj in a navy polo shirt against a white wall" widths={[500, 900]} sizes="(max-width: 900px) 92vw, 420px" class="studio" />
        <h2>Get in touch</h2>
        <a class="mail" href={`mailto:${PERSON.email}`}>{PERSON.email}</a>
        <ul class="icons">
          {
            ICONS.map((s) => (
              <li>
                <a href={s.href} rel="me noopener" target="_blank" aria-label={s.label} title={s.label}>
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                    <path fill="currentColor" d={s.path} />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3>Tools I build with</h3>
        <ul class="tools">
          {
            STACK.map((icon) => (
              <li title={icon.title}>
                <Icon icon={icon} size={28} label={icon.title} />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </footer>
</div>

<script>
  // The line runs from the welcome film through the dot above every post,
  // swaying a little between them, and draws itself as you scroll.
  const root = document.querySelector<HTMLElement>("[data-stage-root]")!;
  const road = root.querySelector<HTMLElement>("[data-road]")!;
  const svg = root.querySelector<SVGSVGElement>("[data-line]")!;
  const trace = root.querySelector<SVGPathElement>("[data-trace]")!;
  const ink = root.querySelector<SVGPathElement>("[data-ink]")!;
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const STEP = 6;
  let length = 0;
  let top = 0;
  let lutY = new Float64Array(0);
  const build = () => {
    const box = road.getBoundingClientRect();
    const w = Math.round(box.width);
    const h = Math.round(box.height);
    svg.setAttribute("width", String(w));
    svg.setAttribute("height", String(h));
    svg.setAttribute("viewBox", `0 0 ${w} ${h}`);
    const nodes = [...road.querySelectorAll<HTMLElement>("[data-node]")].map((el) => {
      const r = el.getBoundingClientRect();
      return { x: r.left + r.width / 2 - box.left, y: r.top + r.height / 2 - box.top };
    });
    if (nodes.length < 2) return;
    const sway = w < 900 ? 0 : 22;
    const pts = [...nodes, { x: nodes[nodes.length - 1].x, y: h }];
    const path = [pts[0]];
    for (let i = 1; i < pts.length; i++) {
      const a = pts[i - 1];
      const b = pts[i];
      const swings = Math.max(1, Math.floor((b.y - a.y) / 700));
      for (let s = 1; s < swings; s++) path.push({ x: a.x + (s % 2 ? sway : -sway), y: a.y + ((b.y - a.y) * s) / swings });
      path.push(b);
    }
    let d = `M ${path[0].x.toFixed(1)} ${path[0].y.toFixed(1)}`;
    for (let i = 1; i < path.length; i++) {
      const a = path[i - 1];
      const b = path[i];
      const k = (b.y - a.y) * 0.5;
      d += ` C ${a.x.toFixed(1)} ${(a.y + k).toFixed(1)}, ${b.x.toFixed(1)} ${(b.y - k).toFixed(1)}, ${b.x.toFixed(1)} ${b.y.toFixed(1)}`;
    }
    trace.setAttribute("d", d);
    ink.setAttribute("d", d);
    length = ink.getTotalLength();
    const n = Math.ceil(length / STEP) + 1;
    lutY = new Float64Array(n);
    for (let i = 0; i < n; i++) lutY[i] = ink.getPointAtLength(Math.min(length, i * STEP)).y;
    ink.style.strokeDasharray = `${length} ${length}`;
    top = box.top + window.scrollY;
    frame();
  };
  const at = (y: number) => {
    let lo = 0;
    let hi = lutY.length - 1;
    if (y <= lutY[0]) return 0;
    if (y >= lutY[hi]) return length;
    while (hi - lo > 1) {
      const mid = (lo + hi) >> 1;
      if (lutY[mid] < y) lo = mid;
      else hi = mid;
    }
    return Math.min(length, (lo + (y - lutY[lo]) / (lutY[hi] - lutY[lo] || 1)) * STEP);
  };
  let queued = false;
  const frame = () => {
    queued = false;
    if (length) ink.style.strokeDashoffset = still ? "0" : String(length - at(window.scrollY + window.innerHeight * 0.6 - top));
  };
  new ResizeObserver(() => build()).observe(road);
  window.addEventListener(
    "scroll",
    () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(frame);
      }
    },
    { passive: true },
  );

</script>


<style>
  .st {
    --night: #0c0c0d;
    --ivory: #f4f1ea;
    --ink: #121212;
    --dim: #67635c;
    --rule: rgb(18 18 18 / 0.12);
    --wide: 1240px;
    font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    color: var(--ink);
    background: var(--ivory);
    /* clip, not hidden: hidden would make this a scroll container and stop the
       cards' scroll-driven marker from following the page */
    overflow-x: clip;
  }

  /* The first screen: the stage */
  .hero {
    position: relative;
    min-height: max(640px, 100svh);
    display: grid;
    align-items: end;
    background: var(--night);
    color: #fff;
    overflow: hidden;
  }
  .hero :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% 35%;
  }
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(0 0 0 / 0.86) 0%, rgb(0 0 0 / 0.35) 38%, rgb(0 0 0 / 0) 62%),
      linear-gradient(to right, rgb(0 0 0 / 0.55) 0%, rgb(0 0 0 / 0) 55%);
  }
  .hero-text {
    position: relative;
    z-index: 1;
    width: min(var(--wide), 100% - 48px);
    margin: 0 auto;
    padding-bottom: clamp(48px, 8vh, 96px);
  }
  h1 {
    font-size: clamp(64px, 11vw, 176px);
    font-weight: 650;
    letter-spacing: -0.055em;
    line-height: 0.86;
    margin-left: -0.04em;
  }
  .hero-line {
    max-width: 640px;
    margin-top: 26px;
    font-size: clamp(19px, 1.8vw, 24px);
    line-height: 1.4;
    color: rgb(255 255 255 / 0.86);
  }
  .icons {
    display: flex;
    gap: 10px;
    margin-top: 30px;
  }
  .icons a {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: 50%;
    color: #fff;
  }
  .hero-credit {
    position: absolute;
    right: 24px;
    bottom: 20px;
    z-index: 1;
    font-size: 12.5px;
    color: rgb(255 255 255 / 0.6);
  }

  /* The road: the welcome film, then the line straight down */
  .road {
    position: relative;
    width: min(var(--wide), 100% - 48px);
    margin: 0 auto;
    padding: clamp(110px, 12vw, 180px) 0 clamp(120px, 12vw, 180px);
  }
  .line {
    position: absolute;
    inset: 0 auto auto 0;
    overflow: visible;
    pointer-events: none;
  }
  .line path {
    fill: none;
    stroke-linecap: round;
  }
  .trace {
    stroke: #cfcfc9;
    stroke-width: 2;
    stroke-dasharray: 2 8;
  }
  .ink {
    stroke: var(--ink);
    stroke-width: 3;
  }
  .welcome {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    padding-bottom: clamp(110px, 12vw, 170px);
  }
  .frame {
    position: relative;
    width: min(1040px, 100%);
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 24px;
    background: #141416;
    box-shadow: 0 40px 80px -48px rgb(0 0 0 / 0.6);
  }
  .frame :global(.frame-bg) {
    position: absolute;
    inset: 0;
  }
  .frame :global(.frame-bg .px-main) {
    object-position: 42% 40%;
  }
  .frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.72) 0%, rgb(0 0 0 / 0.15) 55%, rgb(0 0 0 / 0.05) 100%);
    pointer-events: none;
  }
  .frame-inner {
    position: relative;
    z-index: 1;
    display: grid;
    align-content: end;
    justify-items: start;
    gap: 10px;
    height: 100%;
    padding: clamp(24px, 4vw, 48px);
    color: #fff;
  }
  .play {
    position: relative;
    width: 84px;
    height: 84px;
    margin-bottom: 10px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 16px 40px -12px rgb(0 0 0 / 0.6);
  }
  .play::after {
    content: "";
    position: absolute;
    left: 34px;
    top: 26px;
    border-style: solid;
    border-width: 16px 0 16px 26px;
    border-color: transparent transparent transparent var(--ink);
  }
  .frame h2 {
    font-size: clamp(36px, 4.4vw, 60px);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .frame p {
    max-width: 460px;
    font-size: 17px;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.8);
  }
  .frame .soon {
    padding: 6px 12px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.16);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
  }
  /* What the film says, as text until it is recorded */
  .script {
    width: min(720px, 100%);
    margin-top: clamp(40px, 5vw, 64px);
    padding: clamp(28px, 5vw, 56px);
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.06), 0 34px 70px -40px rgb(0 0 0 / 0.45);
  }
  .script p {
    font-size: 18.5px;
    line-height: 1.7;
    color: #26241f;
    text-wrap: pretty;
  }
  .script p + p {
    margin-top: 18px;
  }
  .script p:first-child {
    font-size: clamp(21px, 2.2vw, 25px);
    font-weight: 560;
    line-height: 1.45;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .script a {
    color: inherit;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }
  .start {
    margin-top: clamp(70px, 8vw, 110px);
  }
  /* The posts, straight down the line, a dot above each */
  .items {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-top: clamp(90px, 10vw, 140px);
  }
  .post {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
  }
  .dot {
    display: block;
    width: 14px;
    height: 14px;
    margin-bottom: 40px;
    border-radius: 50%;
    background: var(--ink);
    box-shadow: 0 0 0 7px var(--ivory);
  }
  .pill {
    padding: 10px 22px;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
    font-size: 19px;
    font-weight: 640;
    box-shadow: 0 0 0 8px var(--ivory);
  }

