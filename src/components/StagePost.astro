---
// A project from the road as a normal blog post: a line
// back to the road, the date and role, the headline and the opening, the big
// photo David picked, then the headline number, the film where there is one,
// and the story under its small headings with photos between the parts and
// the logos of who it was with after its first part, then the sources and the
// newer and older posts.
import "@fontsource-variable/geist/wght.css";
import { getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import Px from "./Px.astro";
import LogoWall from "./LogoWall.astro";
import Clip from "./Clip.astro";
import Press from "./Press.astro";
import { SOCIALS } from "../data/icons";
import { storyHref } from "../data/sections";
import { POSTS } from "../data/road";
import { SECTION_STATS } from "../data/highlights";
import { documentOf, type DocPhoto } from "../data/documents";

interface Props {
  /** The post's section id. */
  id: string;
  covers?: Record<string, DocPhoto>;
}
const { id, covers = {} } = Astro.props;
// Newer and older follow the road's order on the home page.
const i = POSTS.findIndex((p) => p.s.id === id);
const { s, year } = POSTS[i];
const doc = documentOf(s, covers[s.id]);
const newer = POSTS[i - 1];
const older = POSTS[i + 1];
const stat = SECTION_STATS[s.id];
const poster = s.video ? await getImage({ src: s.video.poster, width: 1280, format: "webp" }) : undefined;
// A collage post shows all its photos together at the top, four to six of them.
const collage = [doc.cover, ...doc.pages.map((pg) => pg.photo), ...doc.rest].filter((p) => p !== undefined);
// The logos go at the end of the story's first section, just before its second small heading.
const parts = doc.pages.flatMap((pg, k) => pg.parts.map((part, j) => ({ k, j, h: part.h })));
const second = parts.findIndex((p, n) => n > 0 && p.h);
const wallAt = parts[second > 0 ? second - 1 : parts.length - 1];
// A post can open with its logos instead (Section.logoCover); its photo then takes the logos' place.
const swap = Boolean(s.logoCover && s.logos && wallAt);
// "Featured in Breakit and Ny Teknik" under the opening, for posts with press.
const outlets = [...new Set((s.press ?? []).map((a) => a.outlet))];
// Sources leave out the articles already shown under "In the press".
const sources = (s.links ?? []).filter((l) => !(s.press ?? []).some((a) => a.href === l.href));
const featured = outlets.length > 1 ? `${outlets.slice(0, -1).join(", ")} and ${outlets.at(-1)}` : outlets[0];
const ICONS = ["LinkedIn", "X", "GitHub"].map((n) => SOCIALS.find((x) => x.label === n)!).filter(Boolean);
---

<Base title={`${doc.title} · David Bacelj`} description={s.lede} themeColor="#f4f1ea">
  <div class="post" data-post>
    <nav class="top" aria-label="David Bacelj">
      <a class="back" href={`/#${s.id}`} data-back>← David Bacelj</a>
      <ul>
        {
          ICONS.map((x) => (
            <li>
              <a href={x.href} rel="me noopener" target="_blank" aria-label={x.label} title={x.label}>
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                  <path fill="currentColor" d={x.path} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <article>
      <header class="head">
        <p class="meta">{[year, s.role].filter(Boolean).join(", ")}</p>
        <h1>{doc.title}</h1>
        <p class="lede">{doc.opening.p}</p>
        {featured && (
          <p class="featured">
            Featured in <a href="#press">{featured}</a>
          </p>
        )}
      </header>

      {
        s.collage ? (
          <div class:list={["hero collage", { five: collage.length === 5, six: collage.length >= 6 }]}>
            {collage.map((p, k) => (
                <figure>
                  <Px src={p.photo.src} alt={p.photo.alt} widths={[500, 900, 1300]} sizes={k < 2 ? "(max-width: 700px) 100vw, 740px" : "(max-width: 700px) 50vw, 380px"} loading="eager" cover />
                  <figcaption>{p.caption}</figcaption>
                </figure>
              ))}
          </div>
        ) : swap && s.logos ? (
          <LogoWall logos={s.logos} with={s.with} hero />
        ) : doc.cover && (
          <figure class:list={["hero", { small: doc.cover.photo.src.width < 1000 }]}>
            <Px src={doc.cover.photo.src} alt={doc.cover.photo.alt} widths={[800, 1300, 2000]} sizes="(max-width: 1200px) 100vw, 1120px" loading="eager" fetchpriority="high" />
            <figcaption>{doc.cover.caption}</figcaption>
          </figure>
        )
      }

      <div class="body">
        {
          stat && (
            <p class="stat">
              <b class="marker draw">{stat.value}</b>
              <span>{stat.label}</span>
            </p>
          )
        }

        {
          s.video && poster && (
            <figure class="wide film">
              <video controls preload="metadata" playsinline poster={poster.src}>
                <source src={s.video.src} type="video/mp4" />
              </video>
              <figcaption>{s.video.caption}</figcaption>
            </figure>
          )
        }

        {s.clip && <Clip clip={s.clip} />}

        {!wallAt && s.logos && <LogoWall logos={s.logos} with={s.with} />}

        {
          doc.pages.map((pg, k) => (
            <>
              {pg.parts.map((part, j) => (
                <>
                  {part.h && <h2>{part.h}</h2>}
                  <p>{part.p}</p>
                  {k === wallAt?.k && j === wallAt?.j && (swap ? doc.cover && (
                    <figure class="wide">
                      <Px src={doc.cover.photo.src} alt={doc.cover.photo.alt} widths={[700, 1100, 1600]} sizes="(max-width: 1000px) 100vw, 920px" />
                      <figcaption>{doc.cover.caption}</figcaption>
                    </figure>
                  ) : s.logos && <LogoWall logos={s.logos} with={s.with} />)}
                </>
              ))}
              {pg.photo && !s.collage && (
                <figure class="wide">
                  <Px src={pg.photo.photo.src} alt={pg.photo.photo.alt} widths={[700, 1100, 1600]} sizes="(max-width: 1000px) 100vw, 920px" />
                  <figcaption>{pg.photo.caption}</figcaption>
                </figure>
              )}
            </>
          ))
        }

        {
          doc.rest.length > 0 && !s.collage && (
            <div class:list={["gallery", { one: doc.rest.length === 1 }]}>
              {doc.rest.map(({ photo, caption }) => (
                <figure>
                  <Px src={photo.src} alt={photo.alt} widths={[500, 900]} sizes="(max-width: 800px) 100vw, 440px" />
                  <figcaption>{caption}</figcaption>
                </figure>
              ))}
            </div>
          )
        }

        {
          s.quote && (
            <blockquote>
              <p>{s.quote.text}</p>
              <footer>From the {s.quote.source}</footer>
            </blockquote>
          )
        }

        {s.press && <Press press={s.press} />}

        {
          sources.length > 0 && (
            <section class="sources" aria-label="Sources">
              <h2>Sources</h2>
              <ul>
                {sources.map((l) => (
                  <li>
                    <a href={l.href} rel="noopener" target="_blank">
                      {l.label} ↗
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </article>

    <nav class="more" aria-label="More posts">
      {
        newer ? (
          <a href={storyHref(newer.s.id)}>
            <span>Previous</span>
            {documentOf(newer.s, covers[newer.s.id]).title}
          </a>
        ) : (
          <span />
        )
      }
      {
        older ? (
          <a href={storyHref(older.s.id)} class="older">
            <span>Next</span>
            {documentOf(older.s, covers[older.s.id]).title}
          </a>
        ) : (
          <span />
        )
      }
    </nav>
    <p class="road-link"><a href={`/#${s.id}`} data-back>Back to the road</a></p>
  </div>
</Base>

<script>
  // "Back" returns to the road where you left it when you came from there.
  const root = document.querySelector<HTMLElement>("[data-post]")!;
  const fromRoad = () => {
    try {
      const ref = new URL(document.referrer);
      return ref.origin === location.origin && ref.pathname === "/";
    } catch {
      return false;
    }
  };
  root.querySelectorAll<HTMLAnchorElement>("[data-back]").forEach((a) =>
    a.addEventListener("click", (e) => {
      if (fromRoad() && history.length > 1) {
        e.preventDefault();
        history.back();
      }
    }),
  );
</script>

<style>
  .post {
    --ink: #141414;
    --dim: #6b675f;
    --ivory: #f4f1ea;
    --rule: rgb(20 20 20 / 0.12);
    min-height: 100vh;
    background: var(--ivory);
    color: var(--ink);
    font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    padding: 0 24px 120px;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1120px;
    margin: 0 auto;
    padding: 22px 0;
  }
  .back {
    font-size: 15.5px;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  .top ul {
    display: flex;
    gap: 4px;
  }
  .top ul a {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: var(--ink);
  }
  .top ul a:hover {
    background: rgb(0 0 0 / 0.06);
  }

  .head {
    max-width: 760px;
    margin: clamp(56px, 8vw, 110px) auto 0;
  }
  .meta {
    font-size: 15px;
    color: var(--dim);
  }
  h1 {
    margin-top: 14px;
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 1.02;
  }
  .lede {
    margin-top: 28px;
    font-size: clamp(20px, 2.1vw, 24px);
    line-height: 1.55;
  }
  .featured {
    margin-top: 18px;
    font-size: 15.5px;
    color: var(--dim);
  }
  .featured a {
    font-weight: 600;
    color: var(--ink);
    text-underline-offset: 3px;
  }
  .hero {
    max-width: 1120px;
    margin: clamp(48px, 6vw, 80px) auto 0;
  }
  /* A lead image under 1000 px wide stays at the text's width instead of blurring */
  .hero.small {
    max-width: 760px;
  }
  .hero :global(.px) {
    border-radius: 16px;
  }
  /* The personal post: its photos together as one collage, each caption on its photo */
  .collage {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: repeat(2, clamp(220px, 27vw, 320px));
    gap: 10px;
  }
  .collage figure {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: 16px;
  }
  .collage figure:first-child {
    grid-row: span 2;
  }
  .collage figure:nth-child(2) {
    grid-column: span 2;
  }
  /* Five photos: two on top, three under them */
  .collage.five {
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-template-rows: clamp(220px, 27vw, 340px) clamp(200px, 24vw, 300px);
  }
  .collage.five figure {
    grid-row: auto;
    grid-column: span 2;
  }
  .collage.five figure:nth-child(-n + 2) {
    grid-column: span 3;
  }
  /* Six photos: three and three */
  .collage.six {
    grid-template-rows: repeat(2, clamp(220px, 26vw, 320px));
  }
  .collage.six figure {
    grid-row: auto;
    grid-column: auto;
  }
  .collage :global(.px) {
    height: 100%;
    border-radius: 0;
  }
  .collage figcaption {
    position: absolute;
    inset: auto 0 0;
    margin: 0;
    padding: 36px 16px 14px;
    background: linear-gradient(rgb(0 0 0 / 0), rgb(0 0 0 / 0.6));
    color: #fff;
  }
  figcaption {
    margin-top: 12px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--dim);
  }

  .body {
    max-width: 760px;
    margin: clamp(48px, 6vw, 72px) auto 0;
  }
  .body > p {
    margin-top: 16px;
    font-size: 19px;
    line-height: 1.72;
    color: #26241f;
  }
  .body > h2 {
    margin-top: 52px;
    font-size: clamp(26px, 2.8vw, 32px);
    font-weight: 640;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .stat {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 22px 24px;
    border-radius: 14px;
    background: #fff;
    font-size: 16px;
    line-height: 1.45;
    color: #3d3a34;
  }
  .stat b {
    flex: none;
    font-size: 40px;
    font-weight: 660;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--ink);
  }
  .wide {
    margin: 48px -80px 0;
  }
  .wide :global(.px) {
    border-radius: 14px;
  }
  .film video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    background: #0d1d22;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-top: 48px;
    align-items: start;
  }
  .gallery.one {
    grid-template-columns: minmax(0, 1fr);
  }
  .gallery :global(.px) {
    border-radius: 12px;
  }
  blockquote {
    margin-top: 52px;
    padding-left: 22px;
    border-left: 3px solid var(--ink);
    font-size: 22px;
    line-height: 1.5;
  }
  blockquote footer {
    margin-top: 8px;
    font-size: 14.5px;
    color: var(--dim);
  }
  .sources {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--rule);
  }
  .sources h2 {
    font-size: 15px;
    font-weight: 600;
    color: var(--dim);
  }
  .sources ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin-top: 10px;
    font-size: 16.5px;
    font-weight: 560;
  }
  .sources a {
    color: var(--ink);
  }

  .more {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px;
    max-width: 920px;
    margin: clamp(80px, 9vw, 120px) auto 0;
  }
  .more a {
    display: grid;
    gap: 6px;
    padding: 22px 24px;
    border-radius: 14px;
    background: #fff;
    color: var(--ink);
    font-size: 19px;
    font-weight: 620;
    letter-spacing: -0.02em;
    line-height: 1.3;
    text-decoration: none;
  }
  .more a.older {
    text-align: right;
  }
  .more span {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--dim);
  }
  .road-link {
    max-width: 920px;
    margin: 32px auto 0;
    font-size: 16px;
  }
  .road-link a {
    color: var(--ink);
  }

  @media (max-width: 1000px) {
    .wide {
      margin-left: 0;
      margin-right: 0;
    }
  }
  @media (max-width: 700px) {
    .post {
      padding: 0 16px 110px;
    }
    .hero,
    .wide {
      margin-left: -16px;
      margin-right: -16px;
    }
    .collage {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
      grid-auto-rows: 62vw;
      gap: 4px;
    }
    .collage figure {
      border-radius: 0;
    }
    .collage figure:nth-child(2) {
      grid-column: auto;
    }
    .collage figure:first-child {
      grid-row: auto;
    }
    .collage.five {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
    }
    .collage.five figure,
    .collage.five figure:nth-child(-n + 2),
    .collage.six figure {
      grid-column: auto;
    }
    .collage.six {
      grid-template-rows: none;
    }
    .collage.five figure:first-child {
      grid-column: span 2;
    }
    .collage figcaption {
      padding: 28px 12px 10px;
      font-size: 12.5px;
    }
    .hero :global(.px),
    .wide :global(.px),
    .film video {
      border-radius: 0;
    }
    .hero figcaption,
    .wide figcaption {
      padding: 0 16px;
    }
    .stat {
      flex-direction: column;
      gap: 6px;
    }
    .gallery,
    .more {
      grid-template-columns: minmax(0, 1fr);
    }
    .more a.older {
      text-align: left;
    }
  }
</style>
