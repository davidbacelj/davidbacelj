---
// Look B, "Detections": the computer-vision bounding box is the highlight
// system. The portrait and key words are boxed and labelled the way a detector
// labels what it sees; each row of the story carries its class label.
import "@fontsource-variable/geist/wght.css";
import "@fontsource-variable/geist-mono/wght.css";
import { Picture } from "astro:assets";
import photo from "../assets/david-bacelj.jpg";
import { PERSON, LINKS, TIMELINE } from "../data/profile";

const [leadStart, leadRest] = PERSON.lead.split("Incredible");
const [beforeStart, beforeRest] = PERSON.before.split("machine-vision systems");
---

<div class="look-b">
  <header class="bar">
    <a href="/">David Bacelj</a>
    <nav aria-label="Sections">
      <a href="#story">Story</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <section class="hero" aria-labelledby="name">
    <figure class="shot">
      <Picture
        src={photo}
        formats={["avif", "webp"]}
        widths={[480, 720, 1000]}
        sizes="(max-width: 860px) 92vw, 42vw"
        alt="David Bacelj, smiling, in a black polo shirt in an office"
        loading="eager"
        fetchpriority="high"
      />
      <span class="box person" aria-hidden="true"><span class="tag">david_bacelj</span></span>
      <figcaption class="mono">1 detection: person</figcaption>
    </figure>

    <div class="words">
      <h1 id="name">David Bacelj</h1>
      <p class="lead">
        {leadStart}<span class="hit"><span class="tag" aria-hidden="true">company</span>Incredible</span>{leadRest}
      </p>
      <p class="before">
        {beforeStart}<span class="hit soft"><span class="tag" aria-hidden="true">vision</span>machine-vision systems</span>{beforeRest}
      </p>
    </div>
  </section>

  <section class="story" id="story" aria-labelledby="story-title">
    <h2 id="story-title">What I have worked on</h2>
    <ol class="frames">
      {
        [...TIMELINE].reverse().map((entry) => (
          <li class="frame">
            <span class="year mono">{entry.year}</span>
            <div class="what">
              <span class:list={["tag", "inline", entry.kind]}>{entry.kind}</span>
              <h3>{entry.title}</h3>
              <p>{entry.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="contact" id="contact" aria-labelledby="contact-title">
    <h2 id="contact-title">Find me</h2>
    <ul>
      {
        LINKS.map((link) => (
          <li>
            <a href={link.href} rel="me noopener" target="_blank">{link.label}</a>
          </li>
        ))
      }
    </ul>
    <p class="source mono">
      Source: <a href="https://github.com/davidbacelj/davidbacelj">github.com/davidbacelj/davidbacelj</a>
    </p>
  </section>
</div>

<style>
  .look-b {
    --bg: #f4f5f6;
    --ink: #0d0e10;
    --dim: #5d626a;
    --line: rgb(13 14 16 / 0.12);
    --label: #d9ff3d;
    --sans: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    --mono: "Geist Mono Variable", ui-monospace, Menlo, monospace;
    --page: min(1320px, 100% - 48px);
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 18px;
    line-height: 1.5;
  }

  .mono {
    font-family: var(--mono);
    font-size: 13px;
  }

  .bar {
    width: var(--page);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    padding: 24px 0;
    font-weight: 500;
  }
  .bar a {
    text-decoration: none;
  }
  .bar nav {
    display: flex;
    gap: 28px;
    color: var(--dim);
  }
  .bar nav a:hover {
    color: var(--ink);
  }

  /* The label tab a detector draws on a box's top-left corner. */
  .tag {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.01em;
    background: var(--label);
    color: var(--ink);
    padding: 4px 6px 5px;
    white-space: nowrap;
  }

  .hero {
    width: var(--page);
    margin: 0 auto;
    min-height: calc(100svh - 80px);
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: clamp(32px, 6vw, 112px);
    padding-bottom: 48px;
  }

  .shot {
    position: relative;
    display: grid;
    gap: 12px;
  }
  .shot :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
  }
  .box {
    position: absolute;
    border: 2px solid var(--label);
    box-shadow: 0 0 0 1px rgb(13 14 16 / 0.35);
  }
  .box .tag {
    position: absolute;
    left: -2px;
    bottom: 100%;
  }
  /* Drawn around the figure in the 4:5 crop. */
  .person {
    left: 9%;
    top: 14%;
    width: 70%;
    height: calc(86% - 30px);
  }
  .shot figcaption {
    color: var(--dim);
  }

  .words {
    display: grid;
    gap: 32px;
  }
  h1 {
    font-size: clamp(60px, 8.6vw, 148px);
    font-weight: 620;
    line-height: 0.92;
    letter-spacing: -0.045em;
  }
  .lead {
    font-size: clamp(22px, 2.2vw, 32px);
    line-height: 1.55;
    letter-spacing: -0.015em;
    max-width: 760px;
  }
  .before {
    font-size: clamp(18px, 1.5vw, 22px);
    line-height: 2.05;
    color: var(--dim);
    max-width: 640px;
  }

  /* A word boxed like a detection. */
  .hit {
    position: relative;
    white-space: nowrap;
    outline: 2px solid var(--ink);
    outline-offset: 2px;
    padding: 0 2px;
  }
  .hit .tag {
    position: absolute;
    left: -4px;
    bottom: calc(100% + 4px);
  }
  .hit.soft {
    outline-color: var(--dim);
    color: var(--ink);
  }

  .story {
    width: var(--page);
    margin: 0 auto;
    padding: clamp(80px, 10vw, 160px) 0 0;
  }
  h2 {
    font-size: clamp(40px, 5vw, 76px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    margin-bottom: clamp(32px, 4vw, 64px);
  }
  .frames {
    border-top: 1px solid var(--ink);
  }
  .frame {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 24px;
    padding: 28px 0 30px;
    border-bottom: 1px solid var(--line);
  }
  .year {
    padding-top: 2px;
    color: var(--dim);
  }
  .what {
    display: grid;
    gap: 6px;
    justify-items: start;
    max-width: 780px;
  }
  .tag.inline {
    margin-bottom: 6px;
  }
  .tag.school,
  .tag.work {
    background: transparent;
    outline: 1.5px solid var(--ink);
    outline-offset: -1.5px;
  }
  .what h3 {
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .what p {
    color: var(--dim);
  }

  .contact {
    width: var(--page);
    margin: 0 auto;
    padding: clamp(80px, 10vw, 160px) 0 48px;
  }
  .contact ul {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 44px;
  }
  .contact a {
    font-size: clamp(26px, 3vw, 40px);
    font-weight: 560;
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  .contact a:hover {
    background: var(--label);
  }
  .source {
    margin-top: clamp(64px, 8vw, 120px);
    color: var(--dim);
  }
  .source a {
    font-size: inherit;
    font-weight: 400;
    letter-spacing: 0;
    text-decoration: underline;
  }

  @media (max-width: 860px) {
    .look-b {
      --page: calc(100% - 32px);
      font-size: 17px;
    }
    .hero {
      min-height: 0;
      grid-template-columns: minmax(0, 1fr);
      padding-top: 24px;
    }
    .words {
      order: -1;
    }
    .frame {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
  }
</style>
