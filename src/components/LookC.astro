---
// Look C, "Quiet editorial": huge serif type, lots of air, and the story told
// as a short essay with the years standing in the margin.
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import "@fontsource-variable/inter/opsz.css";
import { Picture } from "astro:assets";
import photo from "../assets/david-bacelj.jpg";
import { PERSON, LINKS, TIMELINE } from "../data/profile";

// One margin year per group of entries from that year, newest first.
const years = [...new Set(TIMELINE.map((e) => e.year))].sort((a, b) => b - a);
const groups = years.map((year) => ({ year, entries: TIMELINE.filter((e) => e.year === year) }));
const [leadStart, leadRest] = PERSON.lead.split(", an assistant");
---

<div class="look-c">
  <header class="bar">
    <a href="/">David Bacelj</a>
    <nav aria-label="Sections">
      <a href="#story">Story</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <section class="hero" aria-labelledby="name">
    <figure class="portrait">
      <Picture
        src={photo}
        formats={["avif", "webp"]}
        widths={[480, 720, 1000]}
        sizes="(max-width: 860px) 92vw, 36vw"
        alt="David Bacelj, smiling, in a black polo shirt in an office"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
    <div class="words">
      <h1 id="name">David <em>Bacelj</em></h1>
      <p class="lead"><span class="ink">{leadStart}</span>, an assistant{leadRest}</p>
      <p class="before">{PERSON.before}</p>
    </div>
  </section>

  <section class="story" id="story" aria-labelledby="story-title">
    <h2 id="story-title">So far</h2>
    {
      groups.map((group, i) => (
        <div class:list={["year-group", { now: i === 0 }]}>
          <p class="year">{group.year}</p>
          <div class="entries">
            {group.entries.map((entry) => (
              <div class="entry">
                <h3>{entry.title}</h3>
                <p>{entry.text}</p>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </section>

  <section class="contact" id="contact" aria-labelledby="contact-title">
    <h2 id="contact-title">Say hello</h2>
    <ul>
      {
        LINKS.map((link) => (
          <li>
            <a href={link.href} rel="me noopener" target="_blank">{link.label}</a>
          </li>
        ))
      }
    </ul>
    <p class="source">
      This site is open source: <a href="https://github.com/davidbacelj/davidbacelj">github.com/davidbacelj/davidbacelj</a>
    </p>
  </section>
</div>

<style>
  .look-c {
    --bg: #faf8f4;
    --ink: #1b1a18;
    --dim: #79736b;
    --line: rgb(27 26 24 / 0.12);
    --accent: #b5532a;
    --serif: "Instrument Serif", ui-serif, Georgia, serif;
    --sans: "Inter Variable", ui-sans-serif, system-ui, sans-serif;
    --page: min(1280px, 100% - 64px);
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 18px;
    line-height: 1.6;
  }

  .bar {
    width: var(--page);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    padding: 28px 0;
    font-size: 16px;
  }
  .bar a {
    text-decoration: none;
  }
  .bar nav {
    display: flex;
    gap: 32px;
    color: var(--dim);
  }
  .bar nav a:hover {
    color: var(--ink);
  }

  .hero {
    width: var(--page);
    margin: 0 auto;
    min-height: calc(100svh - 88px);
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: clamp(40px, 7vw, 128px);
    padding-bottom: 64px;
  }
  .portrait :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: 4px;
  }

  .words {
    display: grid;
    gap: 36px;
  }
  h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(72px, 11vw, 196px);
    line-height: 0.86;
    letter-spacing: -0.025em;
  }
  h1 em {
    display: block;
    font-style: italic;
  }
  .lead {
    font-size: clamp(22px, 2.1vw, 30px);
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--dim);
    max-width: 720px;
  }
  .lead .ink {
    color: var(--ink);
  }
  .before {
    font-size: clamp(17px, 1.4vw, 20px);
    color: var(--dim);
    max-width: 600px;
  }

  .story {
    width: var(--page);
    margin: 0 auto;
    padding-top: clamp(96px, 12vw, 200px);
  }
  h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(56px, 7vw, 112px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin-bottom: clamp(40px, 5vw, 80px);
  }
  .year-group {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 7fr) minmax(0, 2fr);
    gap: 32px;
    padding: 36px 0 40px;
    border-top: 1px solid var(--line);
  }
  .year {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(40px, 4vw, 60px);
    line-height: 1;
    color: var(--dim);
  }
  .now .year {
    color: var(--accent);
  }
  .entries {
    display: grid;
    gap: 28px;
  }
  .entry h3 {
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
    margin-bottom: 4px;
  }
  .entry p {
    color: var(--dim);
    max-width: 640px;
  }

  .contact {
    width: var(--page);
    margin: 0 auto;
    padding: clamp(96px, 12vw, 200px) 0 56px;
  }
  .contact ul {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 48px;
  }
  .contact a {
    font-family: var(--serif);
    font-size: clamp(36px, 4.2vw, 64px);
    line-height: 1.1;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }
  .contact a:hover {
    color: var(--accent);
  }
  .source {
    margin-top: clamp(72px, 9vw, 140px);
    font-size: 15px;
    color: var(--dim);
  }

  @media (max-width: 860px) {
    .look-c {
      --page: calc(100% - 40px);
      font-size: 17px;
    }
    .hero {
      min-height: 0;
      grid-template-columns: minmax(0, 1fr);
      padding-top: 16px;
    }
    .words {
      order: -1;
    }
    .year-group {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
  }
</style>
