---
import "../styles/base.css";
import { PERSON, LINKS } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
  /** The page's background colour, for the browser's own chrome. */
  themeColor?: string;
}

const { title = PERSON.name, description = PERSON.description, themeColor = "#ffffff" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Who the site is about, for search engines.
const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: PERSON.name,
  url: new URL("/", Astro.site).href,
  description: PERSON.bio,
  nationality: { "@type": "Country", name: "Sweden" },
  knowsAbout: PERSON.expertise,
  jobTitle: "Co-founder",
  worksFor: { "@type": "Organization", name: "Incredible", url: "https://www.incredible.one" },
  sameAs: LINKS.filter((l) => l.label !== "Incredible").map((l) => l.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content={themeColor} />
    <meta property="og:site_name" content={PERSON.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="profile" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content="@davidbacelj" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replaceAll("<", "\\u003c")} />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
